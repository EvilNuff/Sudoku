<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sudoku.UI.ViewModels"
             x:Class="Sudoku.UI.Views.StatsView"
             x:DataType="vm:StatsViewModel">
    <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="16" Spacing="16">
            <Grid ColumnDefinitions="Auto,*">
                <Button Content="‹ Menu" Command="{Binding BackCommand}" />
                <TextBlock Grid.Column="1" Classes="heading" Text="Statistics" Margin="16,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatsRow">
                        <Border Classes="card" Margin="0,0,0,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Difficulty}" FontSize="18" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Classes="muted" Text="Best time" />
                                    <TextBlock Grid.Row="1" Text="{Binding Best}" FontSize="20" />
                                    <TextBlock Grid.Column="1" Classes="muted" Text="Best, no hints" />
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding BestNoHints}" FontSize="20" />
                                    <TextBlock Grid.Column="2" Classes="muted" Text="Average" />
                                    <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Average}" FontSize="20" />
                                    <TextBlock Grid.Row="2" Classes="muted" Text="Completed" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="3" Text="{Binding Completed}" />
                                    <TextBlock Grid.Column="1" Grid.Row="2" Classes="muted" Text="Started" Margin="0,8,0,0" />
                                    <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding Started}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Reset statistics" HorizontalAlignment="Left" Command="{Binding ResetCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
