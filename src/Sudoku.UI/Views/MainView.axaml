<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sudoku.UI.ViewModels"
             x:Class="Sudoku.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
    <Panel>
        <ContentControl Content="{Binding CurrentPage}" />

        <!-- Modal dialog overlay -->
        <Border IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource OverlayBrush}">
            <Border Classes="card"
                    DataContext="{Binding Dialog}"
                    x:DataType="vm:DialogViewModel"
                    MaxWidth="420" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Classes="heading" FontSize="22" Text="{Binding Title}" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding CancelText}" IsVisible="{Binding HasCancel}"
                                Command="{Binding CancelCommand}" MinWidth="96" />
                        <Button Classes="accent" Content="{Binding AcceptText}"
                                Command="{Binding AcceptCommand}" MinWidth="96" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
